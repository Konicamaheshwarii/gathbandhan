# Copy to supabase/functions/.env for `supabase functions serve` (that file is gitignored).
# In production set these in Supabase -> Edge Functions -> Secrets instead. Never commit real values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: gateway fee estimate in basis points (236 = 2% + 18% GST) and platform fee (0 = none).
GATEWAY_FEE_BPS=236
PLATFORM_FEE_BPS=0

# Optional: business category for Route linked accounts, if Razorpay asks for a different one.
RAZORPAY_ROUTE_CATEGORY=others
RAZORPAY_ROUTE_SUBCATEGORY=others
